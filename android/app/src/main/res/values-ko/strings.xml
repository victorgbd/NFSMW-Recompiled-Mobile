    <!-- Graphics -->
    <string name="seccion_graficos">그래픽</string>
    <string name="suavizado">안티에일리어싱</string>
    <string name="suavizado_resumen">들쭉날쭉한 가장자리를 부드럽게 합니다. MSAA는 게임 자체의 방식으로 가장 정교하고 가장 무겁습니다. FXAA는 최종 이미지에 거는 필터로 훨씬 가볍지만 조금 더 흐립니다.</string>
    <string name="aa_no">끔</string>
    <string name="msaa_muestras">MSAA 샘플</string>
    <string name="msaa_muestras_resumen">4x는 게임이 쓰는 값입니다(메뉴에서 60fps 대신 46fps). 2x는 덜 부드럽지만 부하도 적습니다.</string>
    <string name="fxaa_calidad">FXAA 품질</string>
    <string name="fxaa_calidad_resumen">높음은 희미한 가장자리까지 더 많이 부드럽게 하고 이미지를 조금 더 부드럽게 만듭니다.</string>
    <string name="fxaa_normal">보통</string>
    <string name="fxaa_alta">높음</string>
    <string name="posprocesado">후처리</string>
    <string name="posprocesado_resumen">원본 게임의 색상 필터와 블러입니다. 끔: GPU 부하는 줄지만 원본처럼 보이지 않습니다.</string>
    <string name="anisotropico">이방성 필터링</string>
    <string name="anisotropico_resumen">멀리 보이는 도로처럼 비스듬히 보이는 텍스처가 더 선명해집니다.</string>
    <string name="aniso_no">끔</string>
    <string name="escala">내부 해상도</string>
    <string name="escala_resumen">2x는 2560×1440으로 그립니다. 더 선명하지만 훨씬 무겁습니다. 1x를 권장합니다.</string>

    <!-- Performance -->
    <string name="seccion_rendimiento">성능</string>
    <string name="fijar_hilos">스레드를 코어에 고정</string>
